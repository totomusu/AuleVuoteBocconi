{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aule-vuote-bocconi",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "SCHEDULE_CACHE",
      "id": "537eaf5b9935439bb81db92b1b3db9ee"
    }
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  "routes": [
    {
      "pattern": "aulebocconi.salvatoremusumeci.com",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
